<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Benchmarks must run as release to get accurate results -->
    <Optimize>true</Optimize>
    <!-- Benchmarks conventionally use underscore-separated names; suppress CA1707 -->
    <NoWarn>$(NoWarn);CA1707;IDE0028</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- Remove packages/usings inherited from tests/Directory.Build.props -->
    <PackageReference Remove="GitHubActionsTestLogger" />
    <PackageReference Remove="xunit.v3.mtp-v2" />
    <Using Remove="Xunit" />
    <Using Remove="Exec.Abstractions" />
    <Using Remove="Exec" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="BenchmarkDotNet.Attributes" />
    <Using Include="BenchmarkDotNet.Running" />
    <Using Include="Exec" />
    <Using Include="Exec.Abstractions" />
    <Using Include="Exec.Services" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\dotnet-exec\dotnet-exec.csproj" />
    <ProjectReference Include="..\..\src\ReferenceResolver\ReferenceResolver.csproj" />
  </ItemGroup>

</Project>
